{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "ios": {
        "distribution": "store",
        "autoIncrement": true
      },
      "android": {
        "distribution": "internal",
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "ios": {},
      "android": {
        "track": "internal"
      }
    },
    "preview": {
      "ios": {}
    }
  }
}
